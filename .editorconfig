root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,tsx,js,jsx,json,jsonc,css,scss,yml,yaml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{java,kt,kts,gradle}]
indent_size = 4

[*.{c,cpp,h,hpp}]
indent_size = 4

[Makefile]
indent_style = tab
